# Frontend (Vite) — copy to `.env` for local development.
# Leave VITE_SUPABASE_* unset to run in Demo Mode: no Supabase, no real AI calls, and no real email.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status

# Edge Function secrets (set via: npx supabase secrets set KEY=value)
# Never commit real keys. Do not put provider or email secrets in VITE_* variables.

# --- Question generation (Settings > AI Provider) ---
# The enabled non-demo row in ai_providers is used. A key saved in the UI
# (encrypted_api_key) wins; otherwise the function reads the secret named by
# secret_ref. Defaults: OPENAI_API_KEY, GEMINI_API_KEY, ANTHROPIC_API_KEY, COMPAT_API_KEY.
# If no provider is enabled, generation falls back to OPENAI_API_KEY.
# OPENAI_API_KEY=sk-...
# OPENAI_QUESTION_MODEL=gpt-4o
# OPENAI_ORGANIZATION_ID=
# OPENAI_PROJECT_ID=
# GEMINI_API_KEY=
# GEMINI_QUESTION_MODEL=gemini-1.5-pro
# ANTHROPIC_API_KEY=
# ANTHROPIC_QUESTION_MODEL=claude-3-5-sonnet-latest
# COMPAT_API_KEY=
# COMPAT_BASE_URL=http://localhost:11434/v1
# COMPAT_QUESTION_MODEL=gpt-4o
# AI_MAX_OUTPUT_TOKENS=8000
# AI_TIMEOUT_MS=120000

# --- Email (Settings > อีเมล, function send-email) ---
# If none of these are set and no non-demo email_providers row is enabled,
# the demo provider logs the message and does not send it.
# Resend is preferred when RESEND_API_KEY and EMAIL_FROM are both set.
# SMTP is used when SMTP_HOST plus SMTP_FROM (or EMAIL_FROM) are set.
# SMTP opens a TCP connection from the edge function. Hosted Supabase may only
# allow HTTPS, in which case use Resend. Local `supabase functions serve` can use either.
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=AI Exam Generator
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=AI Exam Generator
# SMTP_SECURE=false

# ALLOWED_ORIGIN=http://127.0.0.1:5173
# SEED_SECRET=change-me-in-production
