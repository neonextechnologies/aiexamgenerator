############
# Portainer CE — Git stack environment for AI Exam Generator
# Compose path: deploy/docker-compose.yml
# Copy values from: bash deploy/generate-secrets.sh
# Never commit real secrets.
############

# --- Public URLs (NPM TLS → host :3300) ---
SITE_URL=https://examgenerator.neonex.site
API_EXTERNAL_URL=https://examgenerator.neonex.site/auth/v1
ADDITIONAL_REDIRECT_URLS=
APP_HOST_PORT=3300
STUDIO_HOST_PORT=3301

# --- Required secrets ---
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=aiexam
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
REALTIME_DB_ENC_KEY=
PROVIDER_SECRETS_KEY=
GENERATION_WORKER_SECRET=
SEED_SECRET=

# Optional opaque API keys (leave empty to use HS256 ANON_KEY / SERVICE_ROLE_KEY)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# --- Auth ---
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true

# --- SMTP (GoTrue mailer + edge send-email) ---
SMTP_ADMIN_EMAIL=noreply@neonex.site
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="AI Exam Generator"
SMTP_FROM=
SMTP_SECURE=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME="AI Exam Generator"

# --- Studio / API / Storage ---
STUDIO_DEFAULT_ORGANIZATION=Neonex
STUDIO_DEFAULT_PROJECT="AI Exam Generator"
PGRST_DB_SCHEMAS=public,graphql_public,storage
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
FUNCTIONS_VERIFY_JWT=false
STORAGE_TENANT_ID=stub
REGION=stub
GLOBAL_S3_BUCKET=stub
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
IMGPROXY_AUTO_WEBP=true

# --- Seed (production: false — no demo users) ---
SEED_DEMO_USERS=false

# --- Optional LLM keys (Settings UI can store encrypted keys instead) ---
OPENAI_API_KEY=
OPENAI_QUESTION_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_QUESTION_MODEL=gemini-1.5-pro
ANTHROPIC_API_KEY=
ANTHROPIC_QUESTION_MODEL=claude-3-5-sonnet-latest
COMPAT_API_KEY=
COMPAT_BASE_URL=
COMPAT_QUESTION_MODEL=
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_MS=120000
